GENRANQ_ENV=production
DATABASE_URL_APP=postgresql+psycopg://genranq_app:genranq_app@db:5432/genranq
DATABASE_URL_SYSTEM=postgresql+psycopg://genranq_owner:genranq_owner@db:5432/genranq
# 64+ random chars
JWT_SECRET=
# base64 of 32 random bytes:  python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
VAULT_MASTER_KEY=
CORS_ORIGINS=http://localhost:8000
STORAGE_DIR=/app/backend/storage

# Spec source on Google Drive (read-only service account, share the sheet with it as Viewer)
SPEC_DRIVE_FILE_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=

# Platform OAuth apps (leave blank = those providers show NOT CONNECTED for OAuth)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
META_OAUTH_CLIENT_ID=
META_OAUTH_CLIENT_SECRET=
LINKEDIN_OAUTH_CLIENT_ID=
LINKEDIN_OAUTH_CLIENT_SECRET=
X_OAUTH_CLIENT_ID=
X_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=
HUBSPOT_OAUTH_CLIENT_ID=
HUBSPOT_OAUTH_CLIENT_SECRET=
CALENDLY_OAUTH_CLIENT_ID=
CALENDLY_OAUTH_CLIENT_SECRET=
XERO_OAUTH_CLIENT_ID=
XERO_OAUTH_CLIENT_SECRET=
# SSO (OIDC)
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
